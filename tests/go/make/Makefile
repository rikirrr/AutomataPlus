# Переменная для имени бинарника
APP_NAME := app

# Цель по умолчанию для запуска приложения
run: build
	@echo "Запуск приложения..."
	./$(APP_NAME)

# Цель для сборки бинарника
build:
	@echo "Сборка Go-приложения (статически)..."
	# CGO_ENABLED=0 гарантирует статическую сборку (хорошо для Alpine Linux)
	CGO_ENABLED=0 go build -o $(APP_NAME) .

# Цель для очистки собранных файлов
clean:
	@echo "Очистка..."
	rm -f $(APP_NAME)